{% extends "base.html" %}
{% block content %}


<!-- ═══════════ FILTERS ══════════════════════════════════════════════════ -->
<div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap;">

    <select id="filterTime" class="form-control" style="width:140px;font-size:12px;" onchange="refresh()">
        <option value="all" data-i18n="anal.all_time">All time</option>
        <option value="1h" data-i18n="anal.last_1h">Last 1 hour</option>
        <option value="6h" data-i18n="anal.last_6h">Last 6 hours</option>
        <option value="24h" data-i18n="anal.last_24h">Last 24 hours</option>
        <option value="7d" data-i18n="anal.last_7d">Last 7 days</option>
    </select>

    <select id="filterType" class="form-control" style="width:150px;font-size:12px;" onchange="refresh()">
        <option value="" data-i18n="anal.all_types">All attack types</option>
        <option value="SYN_FLOOD">SYN Flood</option>
        <option value="UDP_FLOOD">UDP Flood</option>
        <option value="VOLUMETRIC">Volumetric</option>
        <option value="AMPLIFICATION">Amplification</option>
        <option value="SLOWLORIS">Slowloris</option>
        <option value="PORT_SCAN">Port Scan</option>
        <option value="DISTRIBUTED">Distributed</option>
    </select>

    <select id="filterDecision" class="form-control" style="width:130px;font-size:12px;" onchange="refresh()">
        <option value="" data-i18n="anal.all_events">All events</option>
        <option value="attack">Attacks only</option>
        <option value="normal">Normal only</option>
    </select>

    <button class="btn-soc" onclick="clearFilters()" data-i18n="anal.clear">Clear</button>

    <span id="filterInfo" style="font-size:11px;color:var(--text-dim);font-family:var(--font-mono);"></span>

    <span style="margin-left:auto;font-size:11px;color:var(--text-dim);
                 font-family:var(--font-mono);" id="lastUpdate">—</span>
</div>

<!-- ═══════════ STAT CARDS ══════════════════════════════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="metric-card accent-cyan">
            <div class="metric-label" data-i18n="anal.avg_pps">Avg PPS</div>
            <div class="metric-value text-cyan" id="statPPS">0</div>
            <div class="metric-sub">Packets / second</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card accent-amber">
            <div class="metric-label" data-i18n="anal.avg_bps">Avg BPS</div>
            <div class="metric-value" style="color:var(--amber)" id="statBPS">0</div>
            <div class="metric-sub">Bytes / second</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card accent-green">
            <div class="metric-label" data-i18n="anal.avg_ent">Avg Entropy</div>
            <div class="metric-value text-green" id="statEntropy">0.00</div>
            <div class="metric-sub">Traffic diversity</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card accent-red">
            <div class="metric-label" data-i18n="anal.atk_windows">Attack Windows</div>
            <div class="metric-value text-red" id="statAttacks">0</div>
            <div class="metric-sub">Out of total windows</div>
        </div>
    </div>
</div>

<!-- ═══════════ SERIES CHARTS ═══════════════════════════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="soc-card">
            <h5>Packets per Second</h5>
            <div class="chart-wrap"><canvas id="ppsChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="soc-card">
            <h5>Bytes per Second</h5>
            <div class="chart-wrap"><canvas id="bpsChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="soc-card">
            <h5>Traffic Entropy</h5>
            <div class="chart-wrap"><canvas id="entropyChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="soc-card">
            <h5>Attack Type Distribution</h5>
            <div class="chart-wrap"><canvas id="attackTypeChart"></canvas></div>
        </div>
    </div>
</div>

<!-- ═══════════ RISK SCORE TIMELINE ══════════════════════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="soc-card">
            <h5>Risk Score Timeline</h5>
            <p style="font-size:11px;color:var(--text-secondary);margin-bottom:10px;">
                Composite risk score per window: ML probability × 50 + PPS/100 + severity bonus.
                Higher = more dangerous.
            </p>
            <div style="height:180px;"><canvas id="riskScoreChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="soc-card" style="height:100%;">
            <h5>Top Risks Right Now</h5>
            <div id="topRiskList" style="font-size:12px;">
                <p style="color:var(--text-dim);">No attack data yet.</p>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════ NOTABLE EVENTS SUMMARY ══════════════════════════════════ -->
<div class="soc-card mb-4">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <h5 style="margin-bottom:0;">Notable Events — Risk Prioritized</h5>
        <span style="font-size:11px;color:var(--text-dim);">Sorted by risk score, highest first</span>
    </div>
    <div id="notableList">
        <p style="color:var(--text-dim);font-size:12px;padding:10px;">No notable events yet.</p>
    </div>
</div>

<!-- ═══════════ HEATMAP ══════════════════════════════════════════════════ -->
<div class="soc-card mb-4">
    <h5>Attack Heatmap — Hour of Day × Day of Week</h5>
    <p style="font-size:12px;color:var(--text-secondary);margin-bottom:14px;">
        Stacked bars show attack event count per hour. Colours represent day of week.
        Reveals when your network is most targeted.
    </p>
    <div style="height:180px;"><canvas id="heatmapChart"></canvas></div>
</div>

<!-- ═══════════ ATTACK PROBABILITY TIMELINE ═════════════════════════════ -->
<div class="soc-card mb-4">
    <h5>ML Attack Probability Timeline</h5>
    <div class="chart-wrap"><canvas id="probChart"></canvas></div>
</div>

<!-- ═══════════ RISK SCORE + MITRE TACTIC BREAKDOWN ══════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="soc-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                <h5 style="margin-bottom:0;">Risk Score Timeline</h5>
                <span style="font-size:10px;color:var(--text-dim);">ML prob x50 + PPS/100 + severity weight</span>
            </div>
            <div class="chart-wrap"><canvas id="riskScoreChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="soc-card" style="height:100%;">
            <h5>Risk by MITRE Tactic</h5>
            <div style="height:200px;"><canvas id="tacticsChart"></canvas></div>
        </div>
    </div>
</div>

<!-- ═══════════ DETECTION BREAKDOWN ════════════════════════════════════ -->
<div class="row g-3">
    <div class="col-md-4">
        <div class="soc-card">
            <h5>Detection Method</h5>
            <div style="height:160px;"><canvas id="detectionMethodChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="soc-card">
            <h5>Severity Distribution</h5>
            <div style="height:160px;"><canvas id="severityChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="soc-card">
            <h5>Top Attacker IPs</h5>
            <div id="topIpBars" style="margin-top:4px;"></div>
        </div>
    </div>
</div>

<!-- ═══════════ SCRIPTS ══════════════════════════════════════════════════ -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
    "use strict"

    const T = {
        cyan: "#00d4ff", red: "#ff3d57",
        amber: "#ffab00", green: "#00e676",
        purple: "#b388ff", grid: "rgba(26,48,80,0.7)",
        textSec: "#7a9cc0",
    }
    Chart.defaults.color = T.textSec
    Chart.defaults.borderColor = T.grid
    Chart.defaults.font.family = "'Inter', sans-serif"
    Chart.defaults.font.size = 11

    const MAX = 60

    // Severity band plugin (Slide 23/31 style)
    const severityBandPlugin = {
        id: 'severityBands',
        beforeDraw(chart) {
            if (!chart.config.options.severityBands) return
            const { ctx, chartArea: { top, bottom, left, right }, scales: { y } } = chart
            if (!y) return
            const bands = chart.config.options.severityBands
            bands.forEach(band => {
                const yTop = y.getPixelForValue(band.max ?? y.max)
                const yBottom = y.getPixelForValue(band.min ?? y.min)
                ctx.save()
                ctx.fillStyle = band.color
                ctx.fillRect(left, Math.min(yTop, yBottom), right - left, Math.abs(yBottom - yTop))
                ctx.restore()
            })
        }
    }
    Chart.register(severityBandPlugin)

    function lineChart(id, label, color, withBands = false) {
        const bands = withBands ? [
            { min: 0, max: 0.25, color: 'rgba(0,230,118,0.07)' },
            { min: 0.25, max: 0.5, color: 'rgba(255,214,0,0.07)' },
            { min: 0.5, max: 0.75, color: 'rgba(255,143,0,0.07)' },
            { min: 0.75, max: 1.0, color: 'rgba(255,61,87,0.08)' },
        ] : null
        return new Chart(document.getElementById(id), {
            type: "line",
            data: {
                labels: [],
                datasets: [{
                    label, data: [],
                    borderColor: color,
                    backgroundColor: color.replace(")", ",0.07)").replace("rgb", "rgba"),
                    fill: true, tension: 0.35, pointRadius: 1.5,
                }],
            },
            options: {
                animation: false, responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                severityBands: bands,
                scales: {
                    x: { ticks: { maxTicksLimit: 8, color: T.textSec }, grid: { color: T.grid } },
                    y: { ticks: { color: T.textSec }, grid: { color: T.grid } },
                },
            },
        })
    }

    const ppsChart = lineChart("ppsChart", "PPS", T.cyan)
    const bpsChart = lineChart("bpsChart", "BPS", T.amber)
    const entropyChart = lineChart("entropyChart", "Entropy", T.green)
    const probChart = lineChart("probChart", "ML Prob", T.red, true)
    const riskScoreChart = lineChart("riskScoreChart", "Risk Score", T.purple, false)

    let tacticsChart = null
    let detMethodChart = null
    let severityChartInst = null

    const TACTIC_MITRE_MAP = {
        "T1498": "Impact", "T1498.001": "Impact", "T1498.002": "Impact",
        "T1499": "Impact", "T1499.001": "Impact", "T1046": "Discovery",
        "T1595": "Reconnaissance", "T1590": "Reconnaissance",
    }

    function makeTacticsChart(attacks) {
        const tacticCount = {}
        attacks.forEach(e => {
            const tac = (e.mitre && TACTIC_MITRE_MAP[e.mitre.id]) || "Unknown"
            tacticCount[tac] = (tacticCount[tac] || 0) + 1
        })
        if (tacticsChart) tacticsChart.destroy()
        const entries = Object.entries(tacticCount).sort((a, b) => b[1] - a[1])
        if (!entries.length) return
        tacticsChart = new Chart(document.getElementById("tacticsChart"), {
            type: "bar",
            data: {
                labels: entries.map(([k]) => k),
                datasets: [{
                    data: entries.map(([, v]) => v),
                    backgroundColor: [T.red, T.amber, T.cyan, T.green, T.purple],
                    borderColor: "transparent", borderRadius: 4
                }]
            },
            options: {
                indexAxis: "y", animation: false, responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: T.textSec }, grid: { color: T.grid } },
                    y: { ticks: { color: T.textSec, font: { size: 10 } }, grid: { display: false } }
                }
            }
        })
    }

    function makeDetectionMethodChart(attacks) {
        const ruleCount = attacks.filter(e => e.rule_triggered).length
        const mlCount = attacks.length - ruleCount
        if (detMethodChart) detMethodChart.destroy()
        detMethodChart = new Chart(document.getElementById("detectionMethodChart"), {
            type: "doughnut",
            data: {
                labels: ["Rule-based", "ML only"],
                datasets: [{
                    data: [ruleCount, mlCount],
                    backgroundColor: ["rgba(255,171,0,0.7)", "rgba(0,212,255,0.7)"],
                    borderColor: "transparent"
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, animation: false,
                plugins: { legend: { labels: { color: T.textSec, font: { size: 10 }, padding: 8 } } }
            }
        })
    }

    function makeSeverityChart(attacks) {
        const s = { CRITICAL: 0, HIGH: 0, MEDIUM: 0, LOW: 0 }
        attacks.forEach(e => { if (s[e.severity] !== undefined) s[e.severity]++ })
        if (severityChartInst) severityChartInst.destroy()
        severityChartInst = new Chart(document.getElementById("severityChart"), {
            type: "doughnut",
            data: {
                labels: ["Critical", "High", "Medium", "Low"],
                datasets: [{
                    data: Object.values(s),
                    backgroundColor: ["rgba(255,61,87,.8)", "rgba(255,143,0,.8)", "rgba(255,214,0,.7)", "rgba(0,212,255,.7)"],
                    borderColor: "transparent"
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, animation: false,
                plugins: { legend: { labels: { color: T.textSec, font: { size: 10 }, padding: 6 } } }
            }
        })
    }

    function makeTopIpBars(attacks) {
        const ipCount = {}
        attacks.forEach(e => (e.attackers || []).forEach(ip => { ipCount[ip] = (ipCount[ip] || 0) + 1 }))
        const top = Object.entries(ipCount).sort((a, b) => b[1] - a[1]).slice(0, 6)
        const maxC = top[0]?.[1] || 1
        const el = document.getElementById("topIpBars")
        if (!el) return
        if (!top.length) {
            el.innerHTML = '<span style="color:var(--text-dim);font-size:12px;">No attack data</span>'
            return
        }
        el.innerHTML = top.map(([ip, n]) => `
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:7px;">
                <span style="font-family:var(--font-mono);font-size:10px;color:var(--cyan);
                             width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${ip}</span>
                <div style="flex:1;height:6px;background:var(--bg-surface-2);border-radius:3px;overflow:hidden;">
                    <div style="width:${Math.round(n / maxC * 100)}%;height:100%;background:var(--red);border-radius:3px;"></div>
                </div>
                <span style="font-family:var(--font-mono);font-size:10px;color:var(--red);width:20px;text-align:right;">${n}</span>
            </div>`).join("")
    }

    let typeChart = null
    function makeTypeChart(labels, data) {
        if (typeChart) typeChart.destroy()
        typeChart = new Chart(document.getElementById("attackTypeChart"), {
            type: "doughnut",
            data: {
                labels,
                datasets: [{
                    data,
                    backgroundColor: [T.red, T.amber, T.cyan, T.green, T.purple, "#ff99cc", "#66b2ff"],
                    borderColor: "transparent",
                }],
            },
            options: {
                responsive: true, maintainAspectRatio: false, animation: false,
                plugins: {
                    legend: { labels: { color: T.textSec, font: { size: 11 }, padding: 12 } },
                },
            },
        })
    }

    const DAY = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    const DCOLS = [T.red, T.amber, T.cyan, T.green, T.purple, "#ff99cc", "#66b2ff"]
    let heatChart = null
    function makeHeatmap(events) {
        const grid = Array.from({ length: 7 }, () => new Array(24).fill(0))
        events.filter(e => e.decision === "attack").forEach(e => {
            const d = new Date(e.timestamp * 1000)
            grid[d.getDay()][d.getHours()]++
        })
        if (heatChart) heatChart.destroy()
        heatChart = new Chart(document.getElementById("heatmapChart"), {
            type: "bar",
            data: {
                labels: Array.from({ length: 24 }, (_, i) => `${i}:00`),
                datasets: grid.map((row, i) => ({
                    label: DAY[i], data: row,
                    backgroundColor: DCOLS[i],
                })),
            },
            options: {
                animation: false, responsive: true, maintainAspectRatio: false,
                plugins: { legend: { labels: { color: T.textSec, font: { size: 10 }, padding: 8 } } },
                scales: {
                    x: { stacked: true, ticks: { color: T.textSec }, grid: { color: T.grid } },
                    y: { stacked: true, ticks: { color: T.textSec }, grid: { color: T.grid } },
                },
            },
        })
    }

    function pushLine(chart, labels, data) {
        chart.data.labels = labels.slice(-MAX)
        chart.data.datasets[0].data = data.slice(-MAX)
        chart.update("none")
    }

    function updateStats(series, events) {
        const avg = arr => arr.length ? (arr.reduce((a, b) => a + b, 0) / arr.length).toFixed(2) : 0
        document.getElementById("statPPS").innerText = avg(series.pps)
        document.getElementById("statBPS").innerText = avg(series.bps)
        document.getElementById("statEntropy").innerText = avg(series.entropy)
        document.getElementById("statAttacks").innerText =
            events.filter(e => e.decision === "attack").length
    }

    function getFilterSince() {
        const val = document.getElementById("filterTime").value
        const sinceMap = { "1h": 3600, "6h": 21600, "24h": 86400, "7d": 604800 }
        return sinceMap[val] ? Math.floor(Date.now() / 1000) - sinceMap[val] : null
    }

    function clearFilters() {
        document.getElementById("filterTime").value = "all"
        document.getElementById("filterType").value = ""
        document.getElementById("filterDecision").value = ""
        refresh()
    }

    async function refresh() {
        try {
            // ── Build query params for DB-backed request ──────────────────
            const since = getFilterSince()
            const typeVal = document.getElementById("filterType").value
            const decVal = document.getElementById("filterDecision").value

            // Fetch events from SQLite with server-side filters
            let histUrl = "/api/history?page=1&size=2000"
            if (decVal) histUrl += `&decision=${decVal}`

            const [serRes, evRes] = await Promise.all([
                fetch("/api/traffic_series"),
                fetch(histUrl),
            ])

            const series = await serRes.json()
            const histData = await evRes.json()
            let events = histData.events || []

            // Apply remaining filters client-side (time + type)
            if (since) events = events.filter(e => e.timestamp >= since)
            if (typeVal) events = events.filter(e => e.attack_type === typeVal)

            const attacks = events.filter(e => e.decision === "attack")

            // ── Series — filter by time ───────────────────────────────────
            let filteredSeries = series
            if (since) {
                const keep = series.timestamps
                    .map((t, i) => t >= since ? i : -1)
                    .filter(i => i >= 0)
                filteredSeries = {
                    timestamps: keep.map(i => series.timestamps[i]),
                    pps: keep.map(i => series.pps[i]),
                    bps: keep.map(i => series.bps[i]),
                    entropy: keep.map(i => series.entropy[i]),
                    prob: keep.map(i => series.prob[i]),
                }
            }

            // ── Attack type distribution from filtered events ─────────────
            const dist = {}
            attacks.forEach(e => {
                dist[e.attack_type] = (dist[e.attack_type] || 0) + 1
            })

            // ── Update charts ─────────────────────────────────────────────
            const labels = filteredSeries.timestamps.map(
                t => new Date(t * 1000).toLocaleTimeString()
            )
            pushLine(ppsChart, labels, filteredSeries.pps)
            pushLine(bpsChart, labels, filteredSeries.bps)
            pushLine(entropyChart, labels, filteredSeries.entropy)
            pushLine(probChart, labels, filteredSeries.prob)

            const riskSeries = filteredSeries.prob.map((p, i) =>
                Math.round(p * 50 + (filteredSeries.pps[i] || 0) / 100)
            )
            if (typeof riskScoreChart !== 'undefined') pushLine(riskScoreChart, labels, riskSeries)

            makeTypeChart(
                Object.keys(dist).length ? Object.keys(dist) : ["No attacks"],
                Object.keys(dist).length ? Object.values(dist) : [0]
            )
            makeHeatmap(events)
            if (typeof makeTacticsChart === 'function') makeTacticsChart(attacks)
            if (typeof makeDetectionMethodChart === 'function') makeDetectionMethodChart(attacks)
            if (typeof makeSeverityChart === 'function') makeSeverityChart(attacks)
            if (typeof makeTopIpBars === 'function') makeTopIpBars(attacks)
            buildRiskChart(events)
            updateStats({
                pps: filteredSeries.pps,
                bps: filteredSeries.bps,
                entropy: filteredSeries.entropy,
            }, events)

            // ── Filter info label ─────────────────────────────────────────
            const info = document.getElementById("filterInfo")
            const parts = []
            const timeEl = document.getElementById("filterTime")
            if (timeEl.value !== "all")
                parts.push(timeEl.options[timeEl.selectedIndex].text)
            if (typeVal) parts.push(typeVal)
            if (decVal) parts.push(decVal)
            info.innerText = parts.length
                ? `${parts.join(" · ")} · ${events.length.toLocaleString()} events`
                : `${events.length.toLocaleString()} events`

            document.getElementById("lastUpdate").innerText =
                "Updated " + new Date().toLocaleTimeString()

        } catch (e) { console.error(e) }
    }


    let _riskScoreChart = null

    function buildRiskChart(events) {
        const attacks = events.filter(e => e.decision === "attack")
        const data = attacks.slice(-40).map(e => ({
            t: new Date(e.timestamp * 1000).toLocaleTimeString(),
            r: Math.round((e.attack_probability || 0) * 50 + (e.pps || 0) / 100 +
                (e.severity === "CRITICAL" ? 30 : e.severity === "HIGH" ? 20 : e.severity === "MEDIUM" ? 10 : 5))
        }))

        const canvas = document.getElementById("riskScoreChart")
        if (!canvas) return
        if (_riskScoreChart) _riskScoreChart.destroy()
        _riskScoreChart = new Chart(canvas, {
            type: "line",
            data: {
                labels: data.map(d => d.t),
                datasets: [{
                    data: data.map(d => d.r),
                    borderColor: "#ff3d57",
                    backgroundColor: "rgba(255,61,87,0.08)",
                    fill: true, tension: 0.4, pointRadius: 2,
                }]
            },
            options: {
                animation: false, responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { maxTicksLimit: 8, color: "#7a9cc0" }, grid: { color: "rgba(26,48,80,0.7)" } },
                    y: { ticks: { color: "#7a9cc0" }, grid: { color: "rgba(26,48,80,0.7)" } },
                }
            }
        })

        // Top risks
        const ipRisk = {}
        attacks.forEach(e => {
            (e.attackers || []).forEach(ip => {
                const score = Math.round((e.attack_probability || 0) * 50 + (e.pps || 0) / 100)
                ipRisk[ip] = (ipRisk[ip] || 0) + score
            })
        })
        const sorted = Object.entries(ipRisk).sort((a, b) => b[1] - a[1]).slice(0, 5)
        const topEl = document.getElementById("topRiskList")
        if (topEl) {
            topEl.innerHTML = sorted.length
                ? sorted.map(([ip, score]) => {
                    const color = score > 200 ? "var(--red)" : score > 100 ? "var(--amber)" : "var(--green)"
                    const pct = Math.min(100, (score / Math.max(sorted[0][1], 1)) * 100).toFixed(0)
                    return `
                    <div style="margin-bottom:10px;">
                        <div style="display:flex;justify-content:space-between;margin-bottom:3px;">
                            <code style="font-size:11px;">${ip}</code>
                            <span style="font-family:var(--font-mono);font-weight:700;color:${color};">${score}</span>
                        </div>
                        <div style="height:4px;background:var(--bg-surface-2);border-radius:2px;">
                            <div style="height:100%;width:${pct}%;background:${color};border-radius:2px;transition:width .3s;"></div>
                        </div>
                    </div>`
                }).join("")
                : `<p style="color:var(--text-dim);font-size:12px;">No attack data yet.</p>`
        }

        // Notable events
        const notableEl = document.getElementById("notableList")
        if (notableEl) {
            if (!attacks.length) {
                notableEl.innerHTML = `<p style="color:var(--text-dim);font-size:12px;padding:10px;">No notable events yet.</p>`
            } else {
                const scored = attacks.map(e => ({
                    ...e,
                    _risk: Math.round((e.attack_probability || 0) * 50 + (e.pps || 0) / 100 +
                        (e.severity === "CRITICAL" ? 30 : e.severity === "HIGH" ? 20 : 10))
                })).sort((a, b) => b._risk - a._risk).slice(0, 8)
                notableEl.innerHTML = scored.map(e => {
                    const rc = e._risk > 100 ? "var(--red)" : e._risk > 50 ? "var(--amber)" : "var(--green)"
                    return `
                    <div style="display:flex;align-items:center;gap:10px;padding:9px 12px;
                                border-bottom:1px solid var(--border);">
                        <div style="width:44px;height:44px;border-radius:8px;flex-shrink:0;
                                    background:rgba(255,61,87,0.1);display:flex;align-items:center;
                                    justify-content:center;font-size:14px;font-weight:800;
                                    font-family:var(--font-mono);color:${rc};">${e._risk}</div>
                        <div style="flex:1;">
                            <div style="font-size:12px;color:var(--text-primary);">
                                ${e.attack_type} ·
                                ${(e.attackers || []).map(ip => `<code>${ip}</code>`).join(" ") || "Unknown"}
                            </div>
                            <div style="font-size:10px;color:var(--text-dim);">
                                ${new Date(e.timestamp * 1000).toLocaleTimeString()} ·
                                PPS: ${(e.pps || 0).toFixed(0)} ·
                                ${e.mitre && e.mitre.id
                            ? `<span style="color:var(--purple);font-family:var(--font-mono);">${e.mitre.id}</span>`
                            : ""}
                            </div>
                        </div>
                        <span class="badge-sev ${e.severity}">${e.severity}</span>
                    </div>`
                }).join("")
            }
        }
    }

    refresh()
    setInterval(refresh, 4000)
</script>
{% endblock %}